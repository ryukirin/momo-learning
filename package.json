{
  "name": "momo-learning",
  "version": "0.2.0",
  "description": "墨墨背单词的本地学习镜像（MCP 服务）和每日出题 Skill，可作为 DeepSeek Harness 或 Claude Code 插件安装",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./mcp-server/*": "./mcp-server/*",
    "./skills/*": "./skills/*",
    "./package.json": "./package.json"
  },
  "files": [
    ".claude-plugin",
    "index.js",
    "cordis.patch.yml",
    "verify.mjs",
    "skills",
    "mcp-server/dist",
    "mcp-server/src",
    "mcp-server/scripts",
    "mcp-server/tests",
    "mcp-server/package.json",
    "mcp-server/tsconfig.json",
    "mcp-server/README.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "mcp:install": "npm --prefix mcp-server install",
    "mcp:build": "npm --prefix mcp-server run build",
    "mcp:typecheck": "npm --prefix mcp-server run typecheck",
    "mcp:test": "npm --prefix mcp-server test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryukirin/momo-learning.git"
  },
  "keywords": [
    "maimemo",
    "mcp",
    "model-context-protocol",
    "spaced-repetition"
  ]
}
